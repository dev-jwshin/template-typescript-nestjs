# 환경 설정
NODE_ENV=development

# 애플리케이션 설정
PORT=3000
APP_NAME="NestJS Template"

# CORS 설정
CORS_ORIGIN=*

# 데이터베이스 설정 (Prisma + PostgreSQL)
# 로컬 개발: postgresql://username:password@localhost:5432/database_name
# Docker: postgresql://postgres:postgres@localhost:5432/nestjs_db
# 프로덕션: postgresql://user:password@host:5432/dbname?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nestjs_db"

# JWT 설정 (인증 구현 시 사용)
# JWT_SECRET=your-super-secret-jwt-key
# JWT_EXPIRES_IN=1d

# API 키 (외부 서비스 연동 시 사용)
# API_KEY=your-api-key

# 로그 레벨 (error | warn | info | debug)
# LOG_LEVEL=debug

# 캐시 설정
# 캐시 드라이버: memory (인메모리) | redis (Redis 서버)
CACHE_DRIVER=memory

# Redis 설정 (CACHE_DRIVER=redis일 때만 사용)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=300

# Gzip 압축 설정
# 압축 활성화 여부 (true | false)
COMPRESSION_ENABLED=true
# 압축 레벨 (1-9, 기본값: 6)
# 1 = 최소 압축/최고 속도, 9 = 최대 압축/최저 속도
COMPRESSION_LEVEL=6
# 압축 최소 크기 (bytes, 기본값: 1024 = 1KB)
# 이 크기 미만의 응답은 압축하지 않음
COMPRESSION_THRESHOLD=1024
