# 환경 설정
NODE_ENV=development

# 애플리케이션 설정
PORT=3000
APP_NAME="NestJS Template"

# CORS 설정
CORS_ORIGIN=*

# 데이터베이스 설정 (Prisma + PostgreSQL)
# 로컬 개발: postgresql://username:password@localhost:5432/database_name
# Docker: postgresql://postgres:postgres@localhost:5432/nestjs_db
# 프로덕션: postgresql://user:password@host:5432/dbname?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nestjs_db"

# JWT 설정 (인증 구현 시 사용)
# JWT_SECRET=your-super-secret-jwt-key
# JWT_EXPIRES_IN=1d

# API 키 (외부 서비스 연동 시 사용)
# API_KEY=your-api-key

# 로그 레벨 (error | warn | info | debug)
# LOG_LEVEL=debug
