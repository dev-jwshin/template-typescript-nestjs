// Prisma 스키마 파일
// 문서: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 사용자 모델
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// 감사 로그 모델 (AuditLogPlugin 지원)
model AuditLog {
  id           String   @id @default(uuid())
  action       String   // CREATE, UPDATE, DELETE
  resourceType String   // User, Post 등 리소스 타입
  resourceId   String   // 리소스 ID
  userId       String?  // 작업 수행한 사용자 ID (nullable - 인증 없는 작업 가능)
  ip           String?  // IP 주소
  timestamp    DateTime @default(now())

  @@map("audit_logs")
  @@index([resourceType, resourceId])
  @@index([userId])
  @@index([timestamp])
}
